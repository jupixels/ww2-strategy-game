rules_version = '2';
// Iron Dominion leaderboard.
//   submissions: anyone may create one well-formed submission (a gzipped game record); the Cloud Function
//                replays it and either publishes it to scores or marks it rejected. Readable by id only.
//   scores:      written only by the Cloud Function (the Admin SDK bypasses these rules); readable by everyone.
service cloud.firestore {
  match /databases/{db}/documents {
    match /submissions/{id} {
      allow get: if true;
      allow list, update, delete: if false;
      allow create: if request.resource.data.keys().hasOnly(['name','rec','claim','tag','map','week','v','at'])
        && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 20
        && request.resource.data.rec is string && request.resource.data.rec.size() <= 900000
        && request.resource.data.claim is int && request.resource.data.claim >= 0 && request.resource.data.claim <= 10000
        && request.resource.data.tag is string && request.resource.data.tag.size() <= 4
        && request.resource.data.map in ['world', 'europe']
        && (request.resource.data.week == null || request.resource.data.week is string && request.resource.data.week.size() <= 10)
        && request.resource.data.v is string && request.resource.data.v.size() <= 4
        && request.resource.data.at is timestamp && request.resource.data.at < request.time + duration.value(10, 'm') && request.resource.data.at > request.time - duration.value(10, 'm');
    }
    match /scores/{id} {
      allow read: if true;
      allow write: if false;
    }
  }
}
